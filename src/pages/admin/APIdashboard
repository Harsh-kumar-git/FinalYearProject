package com.scgbs.rwtool.controller;

import com.scgbs.rwtool.model.DashboardStat;
import com.scgbs.rwtool.model.Request;
import com.scgbs.rwtool.model.AdminUser;
import com.scgbs.rwtool.repository.DashboardStatRepository;
import com.scgbs.rwtool.repository.RequestRepository;
import com.scgbs.rwtool.repository.AdminUserRepository;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.*;

import java.util.List;
import java.util.Optional;

@RestController
@CrossOrigin(origins = "http://localhost:3000")
@RequestMapping("/admin/dashboard")
public class AdminDashboardController {

    @Autowired
    private DashboardStatRepository dashboardStatRepository;

    @Autowired
    private RequestRepository requestRepository;

    @Autowired
    private AdminUserRepository adminUserRepository;

    // -------------------- 📊 DASHBOARD STATS --------------------
    @GetMapping("/stats")
    public List<DashboardStat> getDashboardStats() {
        return dashboardStatRepository.findAll();
    }

    @PostMapping("/stats")
    public DashboardStat addDashboardStat(@RequestBody DashboardStat stat) {
        return dashboardStatRepository.save(stat);
    }

    @PutMapping("/stats/{id}")
    public ResponseEntity<DashboardStat> updateDashboardStat(@PathVariable Long id, @RequestBody DashboardStat statDetails) {
        return dashboardStatRepository.findById(id)
                .map(stat -> {
                    stat.setTotal_User(statDetails.getTotal_User());
                    stat.setPendingRequests(statDetails.getPendingRequests());
                    stat.setApproved_Today(statDetails.getApproved_Today());
                    DashboardStat updatedStat = dashboardStatRepository.save(stat);
                    return ResponseEntity.ok().body(updatedStat);
                })
                .orElse(ResponseEntity.notFound().build());
    }

    @DeleteMapping("/stats/{id}")
    public ResponseEntity<?> deleteDashboardStat(@PathVariable Long id) {
        return dashboardStatRepository.findById(id)
                .map(stat -> {
                    dashboardStatRepository.delete(stat);
                    return ResponseEntity.ok().build();
                })
                .orElse(ResponseEntity.notFound().build());
    }

    // -------------------- 📨 REQUESTS --------------------
    @GetMapping("/requests")
    public List<Request> getAllRequests() {
        return requestRepository.findAll();
    }

    @GetMapping("/requests/{id}")
    public ResponseEntity<Request> getRequestByID(@PathVariable Long id) {
        return requestRepository.findById(id)
                .map(request -> ResponseEntity.ok().body(request))
                .orElse(ResponseEntity.notFound().build());
    }

    @PostMapping("/requests")
    public Request createRequest(@RequestBody Request request) {
        request.setStatus("pending");
        return requestRepository.save(request);
    }

    @DeleteMapping("/requests/{id}")
    public ResponseEntity<?> deleteRequest(@PathVariable Long id) {
        return requestRepository.findById(id)
                .map(request -> {
                    requestRepository.delete(request);
                    return ResponseEntity.ok().build();
                })
                .orElse(ResponseEntity.notFound().build());
    }

    // ✅ APPROVE REQUEST AND MOVE TO ADMIN USER TABLE
    @PostMapping("/requests/{id}/approve")
    public ResponseEntity<?> approveRequest(@PathVariable Long id) {
        Optional<Request> optionalRequest = requestRepository.findById(id);

        if (optionalRequest.isPresent()) {
            Request request = optionalRequest.get();
            request.setStatus("approved");
            requestRepository.save(request);

            // copy data to AdminUser table
            AdminUser adminUser = new AdminUser();
            adminUser.setUsername(request.getUsername());
            adminUser.setAdgroup(request.getAdgroup());
            adminUser.setStatus("active");
            adminUserRepository.save(adminUser);

            // delete from requests table (optional)
            // requestRepository.delete(request);

            return ResponseEntity.ok("Access granted and user added to AdminUser table.");
        } else {
            return ResponseEntity.notFound().build();
        }
    }

    // -------------------- 👥 ADMIN USERS --------------------
    @GetMapping("/users")
    public List<AdminUser> getAllAdminUsers() {
        return adminUserRepository.findAll();
    }

    @PutMapping("/users/{id}/revoke")
    public ResponseEntity<AdminUser> revokeAccess(@PathVariable Long id) {
        return adminUserRepository.findById(id)
                .map(user -> {
                    user.setStatus("inactive");
                    AdminUser updatedUser = adminUserRepository.save(user);
                    return ResponseEntity.ok(updatedUser);
                })
                .orElse(ResponseEntity.notFound().build());
    }
}
