package com.scgbs.rwtool.controller;

import com.scgbs.rwtool.model.Request;
import com.scgbs.rwtool.model.AdminUser;
import com.scgbs.rwtool.repository.RequestRepository;
import com.scgbs.rwtool.repository.AdminUserRepository;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.*;

import java.util.*;

@RestController
@RequestMapping("/api/admin")
@CrossOrigin(origins = "*") // Allow frontend calls
public class AdminDashboardController {

    @Autowired
    private RequestRepository requestRepository;

    @Autowired
    private AdminUserRepository adminUserRepository;

    // --------------------- 📊 Dashboard Stats ---------------------
    @GetMapping("/dashboard-stats")
    public ResponseEntity<Map<String, Object>> getDashboardStats() {
        Map<String, Object> stats = new HashMap<>();

        long totalRequests = requestRepository.count();
        long approvedRequests = requestRepository.countByStatus("approved");
        long pendingRequests = requestRepository.countByStatus("pending");

        stats.put("totalRequests", totalRequests);
        stats.put("approvedRequests", approvedRequests);
        stats.put("pendingRequests", pendingRequests);

        return ResponseEntity.ok(stats);
    }

    // --------------------- 📨 Request Management ---------------------
    @GetMapping("/requests")
    public ResponseEntity<List<Request>> getAllRequests() {
        List<Request> requests = requestRepository.findAll();
        return ResponseEntity.ok(requests);
    }

    @GetMapping("/requests/{id}")
    public ResponseEntity<Request> getRequestById(@PathVariable Long id) {
        return requestRepository.findById(id)
                .map(ResponseEntity::ok)
                .orElse(ResponseEntity.notFound().build());
    }

    @PostMapping("/requests")
    public ResponseEntity<Request> createRequest(@RequestBody Request request) {
        request.setStatus("pending");
        Request savedRequest = requestRepository.save(request);
        return ResponseEntity.ok(savedRequest);
    }

    // ✅ Approve Request → Move to AdminUser table
    @PutMapping("/requests/{id}/approve")
    public ResponseEntity<String> approveRequest(@PathVariable Long id) {
        Optional<Request> requestOpt = requestRepository.findById(id);

        if (requestOpt.isPresent()) {
            Request request = requestOpt.get();
            request.setStatus("approved");
            requestRepository.save(request);

            // Copy data to AdminUser
            AdminUser newUser = new AdminUser();
            newUser.setUsername(request.getUsername());
            newUser.setAdgroup(request.getAdgroup());
            newUser.setStatus("active");
            adminUserRepository.save(newUser);

            return ResponseEntity.ok("Access granted and user added to AdminUser table.");
        } else {
            return ResponseEntity.notFound().build();
        }
    }

    // --------------------- 👥 Admin User Management ---------------------
    @GetMapping("/users")
    public ResponseEntity<List<AdminUser>> getAllAdminUsers() {
        List<AdminUser> users = adminUserRepository.findAll();
        return ResponseEntity.ok(users);
    }

    @PostMapping("/users")
    public ResponseEntity<AdminUser> createUser(@RequestBody AdminUser user) {
        user.setStatus("active");
        AdminUser savedUser = adminUserRepository.save(user);
        return ResponseEntity.ok(savedUser);
    }

    // 🚫 Revoke access → set status to inactive
    @PutMapping("/users/{id}/revoke")
    public ResponseEntity<String> revokeAccess(@PathVariable Long id) {
        Optional<AdminUser> userOpt = adminUserRepository.findById(id);

        if (userOpt.isPresent()) {
            AdminUser user = userOpt.get();
            user.setStatus("inactive");
            adminUserRepository.save(user);
            return ResponseEntity.ok("User access revoked successfully.");
        } else {
            return ResponseEntity.notFound().build();
        }
    }
}
